# Required for PostgreSQL. Use a strong, unique value in production.
POSTGRES_PASSWORD=change-me

# Optional defaults
POSTGRES_DB=jobagent
POSTGRES_USER=jobagent
API_PORT=8000
LOG_LEVEL=INFO
LOG_LLM_FLOW=true
LOG_LLM_PROMPTS=false
LOG_LLM_RESPONSES=false
LOG_LLM_MAX_CHARS=4000

# Local-only Elastic observability profile
ELASTIC_PORT=9200
KIBANA_PORT=5601
